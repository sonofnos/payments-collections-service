{
  "info": {
    "name": "payments-collections-service",
    "description": "Idempotent collections, async gateway settlement webhook, and payment status for payments-collections-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "accessToken", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "idempotencyKey", "value": "demo-key-001" },
    { "key": "webhookSecret", "value": "change-me-webhook-secret" }
  ],
  "item": [
    {
      "name": "Issue demo JWT (PAYMENTS_WRITE + PAYMENTS_READ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/token",
        "body": {
          "mode": "raw",
          "raw": "{\"subject\":\"demo-user\",\"roles\":[\"PAYMENTS_WRITE\",\"PAYMENTS_READ\"]}"
        }
      }
    },
    {
      "name": "Initiate collection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('paymentId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/collections",
        "body": {
          "mode": "raw",
          "raw": "{\"idempotencyKey\":\"{{idempotencyKey}}\",\"debtorAccountId\":\"acc-debtor-1\",\"creditorAccountId\":\"acc-creditor-1\",\"amount\":100.00,\"currency\":\"USD\",\"narrative\":\"invoice #1001\"}"
        }
      }
    },
    {
      "name": "Replay same idempotency key (should return same payment, not double-charge)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/collections",
        "body": {
          "mode": "raw",
          "raw": "{\"idempotencyKey\":\"{{idempotencyKey}}\",\"debtorAccountId\":\"acc-debtor-1\",\"creditorAccountId\":\"acc-creditor-1\",\"amount\":100.00,\"currency\":\"USD\",\"narrative\":\"invoice #1001\"}"
        }
      }
    },
    {
      "name": "Get payment status by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/collections/{{paymentId}}"
      }
    },
    {
      "name": "Get payment status by idempotency key",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/collections?idempotencyKey={{idempotencyKey}}"
      }
    },
    {
      "name": "Simulated gateway settlement webhook (HMAC-SHA256 signed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "X-Webhook-Signature",
            "value": "{{$randomAlphaNumeric}}",
            "description": "Compute with: openssl dgst -sha256 -hmac $WEBHOOK_HMAC_SECRET (see README for a full example)"
          }
        ],
        "url": "{{baseUrl}}/api/webhooks/gateway-settlement",
        "body": {
          "mode": "raw",
          "raw": "{\"paymentId\":\"{{paymentId}}\",\"success\":true}"
        }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Swagger UI (open in browser)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/swagger-ui.html"
      }
    }
  ]
}
